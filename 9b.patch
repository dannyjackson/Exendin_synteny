+def lis(pts):
+    """longest run of anchors whose HAL positions rise with their TOGA2 positions."""
+    if not pts:
+        return []
+    best, prev = [1] * len(pts), [-1] * len(pts)
+    for i in range(len(pts)):
+        for j in range(i):
+            if pts[j][0] < pts[i][0] and pts[j][1] < pts[i][1] and best[j] + 1 > best[i]:
+                best[i], prev[i] = best[j] + 1, j
+    i, out = max(range(len(pts)), key=best.__getitem__), []
+    while i >= 0:
+        out.append(pts[i]); i = prev[i]
+    return out[::-1]
+
+
+def fit_anchors(anch, tol):
+    """anch: [(toga2 mid, hal mid, sign)] -> (sign, mapper toga2 coord -> HAL coord, anchors kept,
+    median offset). Orientation by majority; anchors further than tol from the median offset
+    (a paralog anchored to the wrong copy) and out-of-order anchors are dropped; between the
+    kept anchors the map is piecewise linear, beyond them it continues at the end anchor."""
+    sign = 1 if sum(x[2] for x in anch) >= 0 else -1
+    offs = sorted(h - sign * t for t, h, sg in anch if sg == sign)
+    off = offs[len(offs) // 2]
+    pts = {}
+    for t, h, sg in anch:
+        if sg == sign and abs(h - sign * t - off) <= tol:
+            pts.setdefault(t, []).append(h)
+    pts = sorted((t, sorted(hs)[len(hs) // 2]) for t, hs in pts.items())
+    keep = lis([(t, sign * h) for t, h in pts])
+    keep = [(t, sign * u) for t, u in keep]
+    ts = [t for t, _ in keep]
+
+    def f(v):
+        if len(keep) < 2:
+            return sign * v + off
+        i = bisect.bisect_left(ts, v)
+        if i <= 0 or i >= len(keep):
+            t, h = keep[0] if i <= 0 else keep[-1]
+            return h + sign * (v - t)
+        (t0, h0), (t1, h1) = keep[i - 1], keep[i]
+        return h0 + (h1 - h0) * (v - t0) / (t1 - t0)
+    return sign, f, keep, off
+
